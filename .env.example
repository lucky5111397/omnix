# =================================================================
# OMNIX Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your actual values.
# NEVER commit actual secrets, keys, or credentials to source control.
# =================================================================

# -----------------------------------------------------------------
# Core Infrastructure
# -----------------------------------------------------------------
# MongoDB Atlas Connection URI (example placeholder)
MONGO_URI=your_mongodb_connection_uri_here

# Redis URL (localhost:6379 for host dev, redis://redis:6379 for Docker Compose)
REDIS_URL=redis://127.0.0.1:6379

# Qdrant Vector Database URL (localhost:6333 for host dev, http://qdrant:6333 for Docker Compose)
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=placeholder_qdrant_api_key

# Frontend Origin URL
FRONTEND_URL=http://localhost:5173

# Public Gateway URL (for client-accessible download links)
PUBLIC_GATEWAY_URL=http://localhost:8000

# -----------------------------------------------------------------
# Service URLs & Ports
# -----------------------------------------------------------------
GATEWAY_PORT=8000
AUTH_PORT=8001
CHAT_PORT=8002
AGENT_PORT=8003
BILLING_PORT=8004

AUTH_SERVICE_URL=http://localhost:8001
AUTH_SERVICE=http://localhost:8001
CHAT_SERVICE_URL=http://localhost:8002
AGENT_SERVICE_URL=http://localhost:8003
BILLING_SERVICE_URL=http://localhost:8004

# -----------------------------------------------------------------
# Firebase Authentication (Choose ADC, env vars, or serviceAccountKey.json)
# -----------------------------------------------------------------
FIREBASE_PROJECT_ID=placeholder-firebase-project-id
FIREBASE_CLIENT_EMAIL=placeholder-service-account@project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="placeholder_private_key"

# -----------------------------------------------------------------
# Razorpay Payment Gateway
# -----------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_placeholderKeyId
RAZORPAY_KEY_SECRET=placeholder_razorpay_secret

# -----------------------------------------------------------------
# AI / LLM Provider Keys
# -----------------------------------------------------------------
GROQ_API_KEY=placeholder_groq_api_key
GOOGLE_API_KEY=placeholder_google_api_key
GEMINI_API_KEY=placeholder_gemini_api_key
OPENROUTER_API_KEY=placeholder_openrouter_api_key
TAVILY_API_KEY=placeholder_tavily_api_key
